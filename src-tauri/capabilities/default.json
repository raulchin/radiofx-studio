{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Control de audio, biblioteca local y suscripciones desde la ventana principal local",
  "windows": ["main"],
  "permissions": [
    "allow-get-audio-engine-status",
    "allow-list-output-devices",
    "allow-get-selected-output-device",
    "allow-set-output-device",
    "allow-play-effect",
    "allow-stop-playback",
    "allow-stop-effect",
    "allow-stop-all",
    "allow-set-master-volume",
    "allow-set-playback-volume",
    "allow-set-effect-volume",
    "allow-set-max-concurrent-playbacks",
    "allow-get-active-playbacks",
    "allow-get-library-snapshot",
    "allow-save-board",
    "allow-import-audio-files",
    "allow-set-library-columns",
    "allow-play-effect-with-options",
    "allow-restart-effect",
    "allow-set-playback-loop",
    "allow-fade-out-playback",
    "allow-prepare-bank-import",
    "allow-commit-bank-import",
    "allow-cancel-bank-import",
    "allow-export-sound-banks",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}

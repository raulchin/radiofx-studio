{
  "name": "radiofx-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.node.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "check:all": "node scripts/check.mjs",
    "bench:audio": "node scripts/benchmark.mjs",
    "bundle:linux": "node scripts/bundle.mjs linux",
    "bundle:windows": "node scripts/bundle.mjs windows",
    "bundle:macos": "node scripts/bundle.mjs macos",
    "release:artifacts": "node scripts/artifacts.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "icons:generate": "tauri icon src-tauri/icons/radiofx.svg --output src-tauri/icons",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@tauri-apps/api": "^2",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "jsdom": "^26.1.0",
    "@eslint/js": "^10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^17.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "@tauri-apps/cli": "^2"
  }
}
